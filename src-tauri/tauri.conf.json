{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sienna",
  "version": "0.1.0",
  "identifier": "io.github.natunax.sienna",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build && npm run engine:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sienna",
        "width": 1100,
        "height": 780,
        "minWidth": 680,
        "minHeight": 480,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src artifact: http://artifact.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../sidecar/dist/engine.mjs": "sidecar/engine.mjs",
      "../sidecar/node_modules/@anthropic-ai/claude-agent-sdk-darwin-arm64/claude": "sidecar/claude",
      "voice/de.lproj/InfoPlist.strings": "de.lproj/InfoPlist.strings",
      "voice/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings"
    },
    "externalBin": [
      "binaries/sienna-voice",
      "binaries/sienna-snapshot"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0"
    }
  }
}
